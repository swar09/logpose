# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=url_shortener
DATABASE_URL=postgres://postgres:your_password@localhost:5432/url_shortener

# Redis Configuration
REDIS_ADDR=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Server Configuration
SERVER_URL=0.0.0.0:8000
FRONTEND_URL=http://localhost:5173

# Cryptographic Keys
# ID_AES_KEY must be a valid 64-character hex-encoded string (representing a 32-byte key)
ID_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT_ENCODING_KEY must be a secure encoding secret for JSON Web Tokens
JWT_ENCODING_KEY=your_jwt_secret_here

# Payment Gateway (Razorpay)
RAZORPAY_API_KEY=rzp_test_your_key_id
RAZORPAY_API_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Cloudflare Tunnel (Optional for docker-compose)
CLOUDFLARE_TUNNEL_TOKEN=
