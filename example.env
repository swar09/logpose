# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=url_shortener

# Server Configuration
SERVER_URL=localhost:8000   
DATABASE_URL=postgres://postgres:your_password@localhost:5432/url_shortener

# Cryptographic Keys
# ID_AES_KEY must be a valid 64-character hex-encoded string (representing a 32-byte key)
ID_AES_KEY=your_64_character_hex_key_here

# JWT_ENCODING_KEY must be a secure encoding secret for JSON Web Tokens
JWT_ENCODING_KEY=your_jwt_secret_here
